# Relay: copy to root .env only when it does not already exist.
# Node.js 22+ x64. Restart the app after changing this file.
# Existing process environment variables take precedence over .env.

# Board/UI work without model execution. Set 1 when ready to test/use providers.
AGENT_EXECUTION_ENABLED=0

# Authoritative list shown in Configuration > Runtime adapter setup.
# Keep the entire JSON array on ONE line. Empty array means no configured LLMs.
LLM_PROFILES_JSON=[]

# Example A: two API profiles. Replace model IDs and set TEAM_LLM_KEY below.
# Replace the active LLM_PROFILES_JSON=[] line; do not keep duplicate assignments.
# LLM_PROFILES_JSON='[{"id":"main","label":"Main API","runtime":"api","model":"openai/your-main-model-id","api_key_env":"TEAM_LLM_KEY","enabled":true},{"id":"review","label":"Review API","runtime":"api","model":"openai/your-review-model-id","api_key_env":"TEAM_LLM_KEY","enabled":true}]'
# TEAM_LLM_KEY=replace-with-your-provider-key

# Example B: an OpenAI-compatible local endpoint that you run separately.
# LLM_PROFILES_JSON='[{"id":"local","label":"Local model","runtime":"api","model":"openai/your-local-model-id","api_base":"http://127.0.0.1:11434/v1","api_key_env":"LOCAL_LLM_KEY","enabled":true}]'
# LOCAL_LLM_KEY=local

# Example C: CLI profile; authenticate using that CLI's native login first.
# runtime may be codex, claude or gemini. Omit model to use the CLI default.
# LLM_PROFILES_JSON='[{"id":"code","label":"Coding CLI","runtime":"codex","enabled":true}]'
# Add "model":"your-cli-model-id" when you want to pin the model explicitly.
# API profiles still require model. CLI default is not a task-based model router.
# CLI profiles must not contain api_base or api_key_env.
# Optional executable overrides (absolute paths; otherwise search PATH):
# CODEX_BIN=C:/path/to/codex.exe
# CLAUDE_BIN=C:/path/to/claude.cmd
# GEMINI_BIN=C:/path/to/gemini.cmd

# A profile becomes usable only after its own Test LLM succeeds.
# API keys are environment references, never inline JSON fields.
# enabled:false disables a profile after restart.
# Optional allowlist accepts profile references or resolved model IDs:
# CONTROL_ALLOWED_MODELS=profile:main,profile:review
# Optional CLI execution deadline; API requests have their own bounded deadlines:
# AGENT_RUNTIME_TIMEOUT_SECONDS=180

# Firebird Embedded defaults to .data/control.fdb; no DB service required.
# Per-record lock wait in seconds, range 1..10. Conflict returns HTTP 409.
FIREBIRD_LOCK_TIMEOUT_SECONDS=5

# Optional database/native-client overrides; keep defaults for normal setup.
# Use forward slashes and an absolute database path:
# DATABASE_URL=firebird://SYSDBA@/D:/Multi-agent/.data/control.fdb?charset=UTF8
# FIREBIRD_CLIENT_LIBRARY=D:/Multi-agent/.data/firebird-runtime/fbclient.dll

# CONTROL_API_KEY and CONTROL_HUMAN_KEY are generated per launch when unset.
# Do not add shared example keys. Manual backend launch needs both explicitly.
# Paths, optional S3 settings and split-process operation: docs/HANDOFF.md.
