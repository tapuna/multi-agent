# Default: Firebird Embedded in .data/control.fdb; no database service required.
# Optional override, use an absolute path:
# DATABASE_URL=firebird+firebird://SYSDBA@/D:/Multi-agent/.data/control.fdb?charset=UTF8
# Per-lock wait, in seconds (1-10). The default is 5.
FIREBIRD_LOCK_TIMEOUT_SECONDS=5
CONTROL_API_KEY=local-development-key-change-me
CONTROL_HUMAN_KEY=local-human-key-change-me
API_INTERNAL_URL=http://localhost:8000
WORKSPACE_ROOT=./workspaces
AGENT_EXECUTION_ENABLED=1
# Optional model allowlist; otherwise human-registered agent models are allowed.
# CONTROL_ALLOWED_MODELS=openai/your-model
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# GEMINI_API_KEY=...
# LLM_API_BASE=http://127.0.0.1:11434/v1
# LLM_API_KEY=local
# Optional named LLM connections: JSON ARRAY, keep the value on one line.
# Keys stay in separate environment variables; use api_key_env references only.
# LLM_PROFILES_JSON='[{"id":"main","label":"Main API","runtime":"api","model":"openai/your-model-id","api_key_env":"TEAM_LLM_KEY","enabled":true},{"id":"local","label":"Local model","runtime":"api","model":"openai/your-local-model","api_base":"http://127.0.0.1:11434/v1","api_key_env":"LOCAL_LLM_KEY","enabled":true},{"id":"code","label":"Codex CLI","runtime":"codex","model":"your-codex-model-id","enabled":true}]'
# TEAM_LLM_KEY=...
# LOCAL_LLM_KEY=local
# Optional CLI executable overrides: CODEX_BIN, CLAUDE_BIN, GEMINI_BIN
# Optional S3-compatible replication; leave unset to keep artifacts local.
# ARTIFACT_S3_BUCKET=engineering-artifacts
# ARTIFACT_S3_ENDPOINT=https://storage.example.com
# ARTIFACT_S3_ACCESS_KEY=...
# ARTIFACT_S3_SECRET_KEY=...
